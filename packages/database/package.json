{
  "name": "@cashflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:prepare-figurines": "prisma db execute --file prisma/deploy/20260728_add_figurines.sql --schema prisma/schema.prisma",
    "prisma:prepare-password-reset": "prisma db execute --file prisma/deploy/20260802_add_password_reset_tokens.sql --schema prisma/schema.prisma",
    "prisma:prepare-personal-data-consents": "prisma db execute --file prisma/deploy/20260802_add_personal_data_consents.sql --schema prisma/schema.prisma",
    "prisma:prepare-registration-details": "prisma db execute --file prisma/deploy/20260804_add_registration_details.sql --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma --skip-generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:sync-cities": "tsx prisma/seed.ts --sync-cities",
    "prisma:sync-cards": "tsx prisma/seed.ts --sync-cards",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
